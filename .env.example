VECTOR_NAME=Vector
VECTOR_SERIAL=
WIREPOD_HOST=http://127.0.0.1:8080
# HTTP limit for WirePod health checks and transcript polling (1-30 seconds)
WIREPOD_REQUEST_TIMEOUT=5
HOST_WATCHDOG_WIREPOD_EXECUTABLE=C:\Program Files\wire-pod\chipper\chipper.exe
HOST_WATCHDOG_POLL_INTERVAL=0.5
HOST_WATCHDOG_STARTUP_ATTEMPTS=6
HOST_WATCHDOG_APP_RESTART_ATTEMPTS=3

TTS_VOICE=Microsoft Stefan
TTS_VOLUME=90
# Choose onecore or elevenlabs; cloud TTS requires explicit release
TTS_PROVIDER=onecore
TTS_ALLOW_CLOUD=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5
# ElevenLabs synthesis request limit (1-60 seconds)
ELEVENLABS_TIMEOUT=15
ELEVENLABS_STABILITY=0.45
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEED=1.02
# Maximum duration of one allowlisted head, lift, or animation action
ROBOT_ACTION_TIMEOUT=8

# Choose either: console or wirepod
INPUT_MODE=console
VOICE_LISTEN_TIMEOUT=120
# Wakeword-free answer window after a controlled yes/no question (1-10 seconds)
VOICE_FOLLOWUP_TIMEOUT=5
# Use the local German Windows recognizer for the bounded follow-up answer
VOICE_FOLLOWUP_LOCAL=true
VOICE_FOLLOWUP_MIN_CONFIDENCE=0.15
# Keep voice transcripts local unless explicitly enabled
VOICE_ALLOW_CLOUD=false
# Optional provider-independent philosophical reflection guidance
REFLECTION_ENABLED=true

# Choose either: openai or ollama
LLM_PROVIDER=openai
# Used automatically when OpenAI is unavailable; choose ollama or none
LLM_FALLBACK_PROVIDER=ollama

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
# Bounded local voice generation for predictable response latency
OLLAMA_TEMPERATURE=0.25
OLLAMA_MAX_OUTPUT_TOKENS=64
OLLAMA_CONTEXT_WINDOW=4096
# Independent generation limits; defaults preserve the existing runtime behavior
OPENAI_REQUEST_TIMEOUT=120
OLLAMA_REQUEST_TIMEOUT=120
LLM_MAX_ATTEMPTS=2
LLM_RETRY_DELAY=0.5
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_PATH=data/diagnostics/events.jsonl
DIAGNOSTICS_MAX_BYTES=1000000
# Optional absolute path; leave empty for automatic detection
OLLAMA_EXECUTABLE=

# Local semantic vectors; cloud embedding providers are intentionally disabled
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=embeddinggemma
# Use 0 to accept and record the model's native dimension
OLLAMA_EMBEDDING_DIMENSION=0
# Local embedding request limit, independent from Ollama chat (1-600 seconds)
OLLAMA_EMBEDDING_TIMEOUT=60

MEMORY_DB_PATH=data/vector_memory.db
MEMORY_CONTEXT_LIMIT=5
# Store only redacted tool metadata locally and prune it automatically
TOOL_AUDIT_ENABLED=true
TOOL_AUDIT_RETENTION_DAYS=30
TOOL_AUDIT_MAX_ENTRIES=1000
# Imported documents stay local unless explicitly enabled
KNOWLEDGE_ALLOW_CLOUD=false
# Hybrid document ranking (weights are normalized automatically)
KNOWLEDGE_LEXICAL_WEIGHT=0.45
KNOWLEDGE_SEMANTIC_WEIGHT=0.55
KNOWLEDGE_MIN_SIMILARITY=0.35
